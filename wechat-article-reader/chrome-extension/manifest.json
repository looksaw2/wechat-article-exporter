{
  "manifest_version": 3,
  "name": "微信文章本地导出",
  "version": "1.0.0",
  "description": "点击后读取当前已打开的微信公众号文章，预览并保存 Markdown。内容仅在本机处理。",
  "minimum_chrome_version": "96",
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {
    "default_title": "微信文章本地导出",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
